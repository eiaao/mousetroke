  "settings": {
    "drag_timeout_ms": 500,
    "drag_timeout_hint": true,
    "min_stroke_px": 30,
    "target_mode": "under_cursor",
    "pause_hotkey": "#({ESC})",
    "show_tray": true,
    "trail": {
      "show": true,
      "width": 2,
      "border": 1,
      "fade_out": true,
      "color_normal": "#00C2FFE0",
      "color_matched": "#FF7A00F2"
    },
    "label": {
      "show": true,
      "pos": 0.25,
      "border": 1,
      "color_normal": "#FFFFFFE6",
      "color_matched": "#FF7A00F2"
    }
  }
