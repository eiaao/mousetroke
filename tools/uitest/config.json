{
  "version": 1,
  "scopes": [
    {
      "id": "general",
      "name": "所有程序",
      "kind": "global",
      "bindings": [
        {
          "name": "复制",
          "pattern": [
            {
              "type": "press",
              "key": "mouse:right"
            },
            {
              "type": "trace",
              "points": [
                0,
                0,
                0,
                -50,
                50,
                -50
              ]
            }
          ],
          "action": {
            "type": "key_sequence",
            "keys": "^c"
          },
          "execute_on_match": false,
          "hide_label": false,
          "secured": false,
          "name_key": "builtin.gesture.copy"
        },
        {
          "name": "粘贴",
          "pattern": [
            {
              "type": "press",
              "key": "mouse:right"
            },
            {
              "type": "trace",
              "points": [
                0,
                0,
                0,
                50,
                50,
                50
              ]
            }
          ],
          "action": {
            "type": "key_sequence",
            "keys": "^v"
          },
          "execute_on_match": false,
          "hide_label": false,
          "secured": false,
          "name_key": "builtin.gesture.paste"
        },
