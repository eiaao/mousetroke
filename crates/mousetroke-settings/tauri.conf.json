{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mousetroke Settings",
  "version": "0.2.0",
  "identifier": "dev.mousetroke.settings",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mousetroke 设置",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
